{% extends 'base.html.twig' %}

    {% block meta %}
        <meta name = 'csrf-token' content = '{{csrf_token('logout')}}' />
    {% endblock %}
    {% block title %}
        <title>Личный кабинет</title>
    {% endblock %}
    {% block scripts %}
        <script src = 'js/profile/index.js'></script>
    {% endblock %}
    {% block body %}
        <h1>
            {{app.user.getEmail()}}
        </h1>
        {% for i in app.user.getRoles() %}
            <h1>{{i}}</h1>
        {% endfor %}
        <button class = "logout_button">Выйти</button>
    {% endblock %}