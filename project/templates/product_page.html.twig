{% extends 'base.html.twig' %}
    {% block title %}
        {% if productData is not null %}
            <title>{{ productData['title'] }}</title>
        {% else %}
            <title>Товар не найден</title>
        {% endif %}
    {% endblock %}
    {% block stylesheets %}
        <link rel = "stylesheet" href = "/css/product_page.css" />
    {% endblock %}
    {% block body %}
        {% if productData is not null %}
            <div class="product-page">
                <div class="left-column">
                    <img src="/product_images/actual/{{productData['image']}}" class="product-image">
                    <h1 class="product-title">{{ productData['title'] }}</h1>
                    <div class="product-price">{{ productData['price'] }}₽</div>
                </div>
                <div class="right-column">
                    <h2 class="description-title">Описание товара</h2>
                    <div class="product-description">
                        <p class="description-text">
                            {{ productData['description'] }}
                        </p>
                    </div>
                    <button onClick = "window.location = `/product/delete/{{productData['id']}}`">Удалить</button>
                </div>
            </div>
        {% else %}
            <p>Товар не найден</p>
        {% endif %}
    {% endblock %}